flowchart TB
    Producers["Módulos Buk: Nómina, Personas, Encuestas"]
    API["AbstractNotification.deliver"]
    Registry["Definition Registry"]
    Policy{"Policy Engine"}

    DB[("PostgreSQL: requests, deliveries, attempts, events")]
    Frequency[("Frequency buckets / reservations")]
    Groups[("Coalescing groups + eventos originales")]
    Queue[("Solid Queue: jobs en la misma BD")]

    Close["CloseCoalescingWindowJob"]
    Snapshot["Consultar estado vigente"]
    Eligibility{"Reevaluar elegibilidad y canales"}

    AI["Pool ai_generation"]
    Guard["Masking, validación y fallback"]
    LLM["LLM Gateway"]
    Content["Persistir contenido validado"]

    Critical["Pool delivery_critical"]
    Standard["Pool delivery_standard"]
    Adapter["Channel Adapter Registry"]
    SG["SendGrid"]
    Webhook["Webhook firmado y deduplicación"]
    Audit["Auditoría por tenant"]

    Producers --> API
    API --> Registry
    Registry --> Policy

    Policy -->|"DELIVER: persistir solicitud"| DB
    Policy -->|"DELIVER: reserva atómica"| Frequency
    Policy -->|"COALESCE: agrupar sin enviar"| Groups
    Policy -->|"SUPPRESS: registrar razón"| DB

    Groups -->|"Programar cierre único"| Queue
    Queue -->|"Job de cierre"| Close
    Close --> Snapshot
    Snapshot --> Eligibility

    Eligibility -->|"Canales elegibles"| Frequency
    Eligibility -->|"Crear entrega consolidada"| DB
    Eligibility -->|"Sin canales: registrar razón"| DB
    Frequency -->|"Reserva confirmada"| DB

    DB -->|"Encolar tras persistir"| Queue

    Queue -->|"Solo contenido dinámico"| AI
    AI -->|"Contexto permitido"| Guard
    Guard -->|"Prompt sin PII"| LLM
    LLM -->|"Respuesta estructurada"| Guard
    Guard -->|"Validado o fallback"| Content
    Content --> DB

    Queue -->|"Contenido estático o ya generado"| Critical
    Queue -->|"Contenido estático o ya generado"| Standard

    Critical --> Adapter
    Standard --> Adapter
    Adapter -->|"HTTPS API"| SG
    SG -->|"Eventos del proveedor"| Webhook
    Webhook --> DB

    DB --> Audit
    Groups --> Audit
      linkStyle default stroke:#808080
