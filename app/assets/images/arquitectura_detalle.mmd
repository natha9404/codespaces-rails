---
config:
  theme: neo
---
flowchart TB
  subgraph L1["1. ENTRADA — síncrona, sin llamadas externas"]
    Modules["Módulos Buk (servicio de dominio)"] -->|"deliver(recipient, context, idempotency_key)"| API["AbstractNotification.deliver: devuelve request_id"]
    API --> Registry["Definition Registry"]
  end
  subgraph L2["2. GOBIERNO — políticas y admisión"]
    Policy{"Policy Engine: preferencias y canales"}
    Freq[("Frequency buckets y reservations")]
    Group[("Grupo por destinatario, entidad y ventana")]
    Eligibility["Estado vigente + reevaluar canales"]
    NoChannel["Critical sin canal elegible: canal corporativo o fallo crítico + escalar al emisor"]
  end
  subgraph L3["3. PERSISTENCIA — PostgreSQL, fuente de verdad"]
    DB[("PostgreSQL: requests y deliveries")]
    SQ[("Solid Queue (misma base PostgreSQL)")]
    Audit["Auditoría / Soporte: filtro por fecha, destinatario y canal"]
  end
  subgraph L4["4. EJECUCIÓN — workers asíncronos, pools aislados"]
    AI["Pool ai_generation"]
    Critical["Pool delivery_critical"]
    Standard["Pool delivery_standard"]
    Adapter["Channel Adapter Registry"]
    Hook["Webhook firmado y deduplicado"]
  end
  subgraph L5["5. IA — privacidad y costo"]
    Guard["Masking, validación y fallback"]
    Fallback["Fallback determinista: fallo de IA, presupuesto o validación"]
  end
  subgraph L6["6. EXTERNOS — fuera de nuestra frontera"]
    LLM["LLM Gateway"]
    SG["SendGrid"]
  end
  Registry --> Policy
  Policy -->|"DELIVER: idempotencia (UNIQUE), admitir y reservar"| DB
  Policy -->|"SUPPRESS: razón auditable"| DB
  Policy -.->|"COALESCE: extensión propuesta"| Group
  Policy --> Freq
  Policy -->|"critical sin canal"| NoChannel
  Group -.->|"Cierre futuro en delivery_standard"| Eligibility
  Eligibility -.->|"Sin cupo: reprogramar, no suprimir"| Group
  Eligibility -.->|"Entrega consolidada y reserva única"| DB
  DB -->|"Encolado en misma transacción"| SQ
  SQ -->|"Solo dinámicas"| AI
  AI --> Guard
  Guard --> LLM
  LLM --> Guard
  Guard -.->|"si falla"| Fallback
  Guard -->|"Persistir contenido; encolar entrega"| DB
  SQ --> Critical
  SQ --> Standard
  Critical --> Adapter
  Standard --> Adapter
  Adapter --> SG
  Adapter -.->|"timeout: UNKNOWN; reintento acotado y reconciliación"| DB
  SG --> Hook
  Hook --> DB
  DB --> Audit
  Group -.-> Audit
  linkStyle default stroke:#808080
